# Authorization key (base64 client_id:secret) с developers.sber.ru → проект GigaChat API
GIGACHAT_CREDENTIALS=
# Физлицо: GIGACHAT_API_PERS; юрлицо/ИП: GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_B2B

# Сертификат НУЦ Минцифры (лежит в certs/, см. https://developers.sber.ru/docs/ru/gigachat/certificates)
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
# Только для локальной отладки вместо сертификата:
# GIGACHAT_VERIFY_SSL_CERTS=false

# Роутинг по моделям (сверить с актуальной линейкой в доках — обновляется несколько раз в год)
# VISION_MODEL=GigaChat-2-Max
# SOLVER_MODEL=GigaChat-2-Max
# TUTOR_MODEL=GigaChat-2-Pro
# LITE_MODEL=GigaChat-2

# Токен бота MAX (dev.max.ru, MasterBot)
MAX_TOKEN=
# platform-api2.max.ru подписан НУЦ Минцифры — тот же корень, что для GigaChat.
# Отличие: для GigaChat SDK этот файл ЗАМЕНЯЕТ хранилище, для MAX — ДОБАВЛЯЕТСЯ к certifi
# (медиа могут отдаваться с хостов под публичными CA)
MAX_CA_BUNDLE=certs/russian_trusted_root_ca.cer

# prod-события идут в конкурсный зачёт, dev — нет (антифрод)
ENVIRONMENT=dev
# Обезличенные id тестеров (поле "user" в var/events.jsonl) через запятую:
# в prod их события пишутся с env=test и не попадают в зачёт
# TEST_USERS=a1b2c3d4e5f60718,0123456789abcdef

# Состояние диалога: пусто — в памяти процесса (локально); в docker-compose задан Redis
# REDIS_URL=redis://localhost:6379/0

# Фото домашек для разбора спорных проверок (152-ФЗ: только обезличенный id в имени, TTL)
# PHOTOS_DIR=var/photos
# PHOTOS_TTL_DAYS=30   # 0 — не сохранять

# Страницы учебников для базы знаний (языки): печатный текст без данных ребёнка, поэтому
# хранятся дольше домашек — эталон упражнения переиспользуется другими учениками
# KB_PHOTOS_DIR=var/kb_photos
# KB_PHOTOS_TTL_DAYS=365   # 0 — не сохранять

# Лог бота в файл с ротацией (в docker-compose задан var/bot.log); пусто — только stderr
# LOG_PATH=var/bot.log

# Параллельная обработка апдейтов (docs/deploy.md «Параллельная обработка апдейтов»): разные
# чаты — одновременно, один чат — строго по порядку.
# Сколько апдейтов обрабатывается одновременно; 1 — по одному, как до диспетчера (откат)
# UPDATE_CONCURRENCY=8
# Порог необработанных апдейтов: достигнут — бот не опрашивает MAX, пока очередь не разгрузится
# до половины порога (апдейты ждут на стороне MAX, а не в памяти бота)
# UPDATE_QUEUE_LIMIT=100
# Остановка (SIGTERM): секунд на дообработку принятых апдейтов, дальше — отмена и запись в лог,
# сколько апдейтов потеряно. Меньше stop_grace_period в docker-compose.yml (150 с)
# SHUTDOWN_TIMEOUT_S=100

# Онбординг (спецификация 2026-09-14). Секреты: python -m hwcheck keys >> .env
# Копию ID_HASH_KEY и USER_ID_KEY хранить вне сервера: без них бот не найдёт и не напишет пользователям
# ID_HASH_KEY=
# USER_ID_KEY=
# POSTGRES_PASSWORD=
# PostgreSQL; в docker-compose задан сам. Пусто — бот без базы
# DATABASE_URL=postgresql://homework:<пароль>@localhost:5432/homework

# Онбординг и согласие родителя до проверки: true — фото проверяются только после согласия;
# false — аварийный выключатель, бот работает без онбординга. При true нужны DATABASE_URL, ID_HASH_KEY,
# USER_ID_KEY и username бота (GET /me)
# ONBOARDING_REQUIRED=false

# Отчёт родителю раз в неделю (docs/deploy.md «Отчёт родителю раз в неделю»): true — бот сам
# присылает отчёт о прогрессе; false — рассылки нет, отчёт по кнопке «📈 Отчёт о прогрессе»
# работает. Рассылке нужен онбординг: ONBOARDING_REQUIRED=true, база и ключи id
# WEEKLY_REPORT=false
# День недели рассылки: 0 — понедельник, 6 — воскресенье. От него же надпись на выключателе
# под отчётом: «Не присылать по воскресеньям»
# WEEKLY_REPORT_WEEKDAY=6
# Час рассылки по московскому времени, от 9 до 21: с 22 до 9 бот родителям не пишет, и с часом
# из этого промежутка он не стартует
# WEEKLY_REPORT_HOUR=18
# Пауза между родителями в рассылке, секунды: общий предел рассылки у MAX неизвестен
# WEEKLY_REPORT_PAUSE_S=0.5

# OCR-сервис для языков (контейнер homework-ocr, docker-compose профиль ocr); пусто — предметы
# с OCR недоступны. На VPS контейнер пока только собирается (docs/deploy.md «OCR-сервис»),
# поэтому переменная пуста и в compose.
# Включить OCR: раскомментировать строку ниже (в compose — адрес сервиса в его сети,
# локально вне compose — адрес запущенного процесса) и поднять сервис:
#   docker compose --profile ocr up -d ocr
# OCR_URL=http://ocr:8080
# OCR_ENGINE=fake  # движок сервиса `ocrsvc/` (ocrsvc/engine.py): fake | readingpipeline;
# в образе `ocrsvc/Dockerfile` уже задан readingpipeline — эта переменная нужна, только чтобы
# запустить сервис с фейком (тесты, разработка без весов)

# Шлюз моделей с OpenAI-совместимым API (организаторы Sber500 x Disrupt). Модель шага идёт
# через шлюз, если её имя начинается с «gw:»: VISION_MODEL=gw:<модель>, SOLVER_MODEL=gw:…
# Список моделей: GET <LLM_GATEWAY_URL>/models. GIGACHAT_CREDENTIALS можно не задавать, если
# все модели идут через шлюз.
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
# Чтение фото. VISION_MODEL — для семей, чьё согласие дано по политике v2 и новее (она говорит о
# передаче фото сторонней модели); VISION_MODEL_DOMESTIC — для остальных и для бота без онбординга.
# VISION_MODEL=gw:gemini-3.1-pro-preview
# VISION_MODEL_DOMESTIC=GigaChat-2-Max
# Промпт транскрипции под модель чтения (prompts/vision/<версия>.md): v3 писался под GigaChat,
# сторонней модели шлюза — свой v4-<модель>; версия пишется в журнал llm_call.
# VISION_PROMPT=v4-gemini
# VISION_PROMPT_DOMESTIC=v3
