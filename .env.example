# Authorization key (base64 client_id:secret) с developers.sber.ru → проект GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Сертификат Минцифры для gigachat.devices.sberbank.ru.
# Скачать: https://developers.sber.ru/docs/ru/gigachat/certificates
# Либо укажи путь к .cer, либо (только для локальной отладки) выключи проверку.
# GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
# GIGACHAT_VERIFY_SSL_CERTS=false

# Роутинг по моделям (сверить с актуальной линейкой в доках — обновляется несколько раз в год)
# VISION_MODEL=GigaChat-2-Max
# SOLVER_MODEL=GigaChat-2-Max
# TUTOR_MODEL=GigaChat-2-Pro
# LITE_MODEL=GigaChat-2
