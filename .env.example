# Authorization key (base64 client_id:secret) с developers.sber.ru → проект GigaChat API
GIGACHAT_CREDENTIALS=
# Физлицо: GIGACHAT_API_PERS; юрлицо/ИП: GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_B2B

# Сертификат НУЦ Минцифры (лежит в certs/, см. https://developers.sber.ru/docs/ru/gigachat/certificates)
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
# Только для локальной отладки вместо сертификата:
# GIGACHAT_VERIFY_SSL_CERTS=false

# Роутинг по моделям (сверить с актуальной линейкой в доках — обновляется несколько раз в год)
# VISION_MODEL=GigaChat-2-Max
# SOLVER_MODEL=GigaChat-2-Max
# TUTOR_MODEL=GigaChat-2-Pro
# LITE_MODEL=GigaChat-2

# Токен бота MAX (dev.max.ru, MasterBot)
MAX_TOKEN=
# platform-api2.max.ru подписан НУЦ Минцифры — тот же корень, что для GigaChat.
# Отличие: для GigaChat SDK этот файл ЗАМЕНЯЕТ хранилище, для MAX — ДОБАВЛЯЕТСЯ к certifi
# (медиа могут отдаваться с хостов под публичными CA)
MAX_CA_BUNDLE=certs/russian_trusted_root_ca.cer

# prod-события идут в конкурсный зачёт, dev — нет (антифрод)
ENVIRONMENT=dev
