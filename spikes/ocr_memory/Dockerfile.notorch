# Спайк памяти, попытка #4: тот же пайплайн (ONNX, без LM), но БЕЗ torch/torchvision
# вообще — они не нужны на этом пути инференса (см. patch_no_torch.py для полного
# обоснования по коду апстрима). Экономит ~200 МБ RSS на голом импорте torch+
# torchvision (измерено отдельно, см. docs/research/2026-09-17-readingpipeline-memory.md).
# Не для прода — только измерения.
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git g++ libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Без torch/torchvision — CRNN/LinkResNet (torch nn.Module) и OCRTorchModel/
# SegmTorchModel не импортируются вовсе после patch_no_torch.py.
RUN pip install --no-cache-dir \
        numpy==1.23.1 \
        opencv-python==4.6.0.66 \
        tqdm==4.62.3 \
        matplotlib==3.5.0 \
        Pillow==8.4.0 \
        pyclipper==1.3.0 \
        shapely==1.8.0 \
        onnxruntime==1.17.3 \
        openvino==2024.6.0 \
        pandas==1.3.4 \
        scikit-learn==1.3.2 \
        scipy==1.10.1 \
        albumentations==1.1.0 \
        huggingface_hub

RUN git clone --depth 1 https://github.com/ai-forever/ReadingPipeline.git \
    && git clone --depth 1 https://github.com/ai-forever/OCR-model.git \
    && git clone --depth 1 https://github.com/ai-forever/SEGM-model.git
RUN printf 'class CTCBeamDecoder:\n    def __init__(self, *a, **kw):\n        raise NotImplementedError("ctcdecode stub: LM disabled in spike")\n' \
        > /usr/local/lib/python3.10/site-packages/ctcdecode.py

COPY patch_no_torch.py /app/patch_no_torch.py
RUN python /app/patch_no_torch.py \
    && pip install --no-cache-dir --no-deps ./OCR-model ./SEGM-model

RUN python -c "from huggingface_hub import snapshot_download; \
    snapshot_download('ai-forever/ReadingPipeline-notebooks', local_dir='/app/weights', \
    ignore_patterns=['*.arpa', '*.ipynb', '*.jpg', 'ocr/*.ckpt', 'segm/*.ckpt'])"

# Лучшая найденная в попытках 1-2 комбинация (см. отчёт): арена и mem-pattern
# onnxruntime выключены — единственная настройка, которая снижает пик без
# изменения текста; сегментация остаётся на родном 896x896 (попытка #3 меняет
# распознанный текст сильнее допуска, см. отчёт, поэтому не входит в дефолт).
ENV MALLOC_ARENA_MAX=2
ENV OMP_NUM_THREADS=2
ENV OCR_MEM_THREADS=2
ENV OCR_MEM_ORT_ARENA=0
ENV OCR_MEM_ORT_MEMPATTERN=0
ENV OCR_MEM_RUNTIME=ONNX
ENV OCR_MEM_SEGM_SIZE=
ENV OCR_MEM_SEGM_MODEL_PATH=

COPY run.py /app/run.py
ENTRYPOINT ["python", "/app/run.py"]
